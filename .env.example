# Copy to .env.local for local dev.
# On Vercel: Project Settings → Environment Variables

# MySQL (XAMPP locally, or a cloud MySQL host for Vercel)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=pap

# Public site URL (no trailing slash)
APP_URL=http://localhost:3000

# Session encryption (long random string)
SESSION_SECRET=change-me-to-a-long-random-secret

# Admin alert email
ADMIN_EMAIL=your-email@example.com

# Optional: outbound email (Nodemailer). Leave blank to log emails in console locally.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Reporta Évora <no-reply@example.com>"

# Optional: Twilio SMS alerts for new occurrences
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
TWILIO_TO=
